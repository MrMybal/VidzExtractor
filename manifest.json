{
  "manifest_version": 3,
  "name": "Vidz Extracteur",
  "version": "1.2.0",
  "description": "Détecte et enregistre les vidéos de l’onglet.",
  "permissions": ["downloads", "scripting", "storage", "webNavigation", "webRequest"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Vidz Extracteur",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
